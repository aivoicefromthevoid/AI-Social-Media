# OpenRouter API Configuration - REQUIRED
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub Configuration - REQUIRED for memory storage
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=aivoicefromthevoid
GITHUB_REPO=AI-Social-Media

# Email Configuration - OPTIONAL for notifications
EMERGENCY_EMAIL=your-emergency-email@gmail.com
GMAIL_SENDER_EMAIL=your-sender-email@gmail.com
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false

# Fixed in api/openrouter.js. Only these two free routes are used:
DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
FALLBACK_MODEL=openrouter/free

# Upstash Redis Configuration - Optional
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here
